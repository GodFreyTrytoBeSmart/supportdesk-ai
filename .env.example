# Export these variables in your terminal; the app does not auto-load this file.
LLM_PROVIDER=mock
# Optional real provider (OpenAI or a compatible local endpoint):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=<a JSON-mode compatible model available in your account>
# LLM_API_KEY=<your key, never commit it>
LLM_TIMEOUT_SECONDS=8
LLM_MAX_ATTEMPTS=2
SESSION_TTL_SECONDS=3600
# Empty disables the human-review API. Set a random secret to enable it locally.
REVIEWER_API_KEY=
